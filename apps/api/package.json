{
  "name": "@helpdesk/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @helpdesk/contract build && nest start --watch",
    "build": "pnpm --filter @helpdesk/contract build && nest build",
    "start": "node dist/main.js",
    "pretest": "pnpm --filter @helpdesk/contract build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --filter @helpdesk/contract build",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@helpdesk/contract": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-mssql": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "mssql": "^11.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@swc/core": "1.15.47",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/mssql": "^9.1.5",
    "@types/node": "24.13.3",
    "dotenv": "^16.4.5",
    "prisma": "7.9.1",
    "tsx": "4.23.8",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.10",
    "vitest": "4.1.10"
  }
}
